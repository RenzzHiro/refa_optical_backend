  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/healthz", "destination": "/go?__vercel_path=healthz" },
    { "source": "/readyz", "destination": "/go?__vercel_path=readyz" },
